# JWT & Security
SECRET_KEY=your_secret_key_here

# SMTP (например, Gmail, Yandex, Mailgun, Sendgrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shop@example.com
SMTP_PASSWORD=app_specific_password_here
SMTP_FROM_EMAIL=noreply@example.com

# Telegram уведомления менеджерам
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=CHAT_ID   # ID группы или личного чата

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Данные для подключения к БД (PostgreSQL)
# Для Docker используйте: DB_HOST=postgres
# Для локального запуска вне Docker: DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=api_rope_shop

# Режим работы приложения (DEV / PROD)
MODE=DEV

# Данные администратора
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Шаблон публичной ссылки для трекинга заказа
ORDER_TRACKING_URL_TEMPLATE={site_url}/order-tracking/{request_number}?token={token}
