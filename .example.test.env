# JWT & Security
SECRET_KEY=your_test_secret_key_here

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Данные тестовой БД (PostgreSQL)
# Для запуска тестов локально: DB_HOST=localhost
# Для запуска внутри сети Docker: DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=api_sample_test

# Режим работы для тестов (обязательно TEST)
MODE=TEST
