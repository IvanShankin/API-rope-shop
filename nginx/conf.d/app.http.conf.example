# Example configuration for HTTP-only mode (useful for initial certbot verification or staging)
# To use this: rename or copy to app.conf before SSL certificates are created.

upstream backend_api {
    server backend_rope_shopo:8018;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    client_max_body_size 25M;

    # Let's Encrypt / Certbot ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Static Media Files
    location /media/ {
        alias /app/media/;
        autoindex off;
        expires 30d;
        add_header Cache-Control "public, no-transform, immutable";
        add_header Access-Control-Allow-Origin "*";
        add_header Access-Control-Allow-Methods "GET, OPTIONS";
        add_header Access-Control-Allow-Headers "*";

        location ~ /\.(?!well-known).* {
            deny all;
        }

        try_files $uri =404;
    }

    # Health Check
    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    # Reverse Proxy to FastAPI
    location / {
        limit_req zone=api_limit burst=50 nodelay;
        limit_conn addr_limit 30;

        proxy_pass http://backend_api;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
